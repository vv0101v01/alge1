///|
/// Axiom 入口 — HoTT 重構版演示

fn main {
  println("=== Axiom — HoTT 零成本抽象演示 (v0.10.15) ===")
  println(@axiom.hello())
  println("")
  println("--- 範疇論核心 (HoTT 再定義) ---")
  println("ObjTag / Category / Functor / NatTrans / Yoneda 已載入")
  let cat = @axiom.DiscreteCat::make([@axiom.ObjTag("A"), @axiom.ObjTag("B")])
  println("離散範疇對象數: " + cat.objs.length().to_string())
  let hom = @axiom.HomFunctor::make(@axiom.ObjTag("A"))
  println("Hom(A,A) 大小: " + hom.hom_set(@axiom.ObjTag("A")).length().to_string())
  let hott_cat = @axiom.HoTTCat::make(@axiom.TypeTag("Ob"), @axiom.GroupoidLevel)
  println("HoTT 範疇 h-level: GroupoidLevel, 再定義驗證: " + @axiom.hott_functor_preserves_paths(@axiom.HoTTFunctor::make(fn(x : Int) -> Int { x }), @axiom.refl(1)).code.to_string())
  println("")
  println("--- 等價 / 自由 / 平坦函子 (HoTT: Equiv/ HIT/ Trunc) ---")
  let eq = @axiom.Equivalence::make([(@axiom.ObjTag("A"), 1, -1)], [(@axiom.ObjTag("B"), 2, -2)])
  println("等價三角恆等式: " + eq.check_triangle().to_string())
  let term : @axiom.Free[Int] = @axiom.Op("mul", [@axiom.Return(6), @axiom.Return(7)])
  let folded = term.fold(fn(x) { x }, fn(n, a) { if n == "mul" { a[0] * a[1] } else { 0 } })
  println("自由項 fold (6*7): " + folded.to_string())
  println("HoTT 自由HIT: Return(42) 已構造")
  let flat = @axiom.FlatFunctor::make([@axiom.ObjTag("X")])
  flat.advance(@axiom.ObjTag("X"), 42)
  println("平坦函子求值: " + flat.eval(@axiom.ObjTag("X")).to_string())
  println("HoTT 平坦截斷: " + @axiom.FlatHoTT::make(flat, @axiom.SetLevel).is_flat_hott().to_string())
  println("")
  println("--- Vect_k (HoTT: 0-截斷 Set) ---")
  let field = @axiom.DoubleField::{}
  let v = @axiom.Vect::from_array([1.0, 2.0, 3.0])
  let w = @axiom.Vect::from_array([4.0, 5.0, 6.0])
  let d = @axiom.pairing_double(v, w, field)
  println("配對 <v,w>: " + d.to_string())
  let t = @axiom.tensor_double(v, @axiom.Vect::from_array([10.0, 20.0]), field)
  println("張量維度 dim(V⊗W): " + t.dim.to_string() + " 預期 6")
  let proj = @axiom.random_projection(8, 3, 2026)
  println("JL 投影 8→3 矩陣: " + proj.rows.to_string() + "x" + proj.cols.to_string())
  println("HoTT Vect 等價即相等: " + @axiom.vect_hott_path(@axiom.VectHoTT::make(3), @axiom.VectHoTT::make(3), @axiom.Equiv::make(fn(x : @axiom.VectHoTT) -> @axiom.VectHoTT { x }, fn(x : @axiom.VectHoTT) -> @axiom.VectHoTT { x })).code.to_string())
  println("")
  println("--- Topos (HoTT: ∞-Topos) & 線性邏輯 (HoTT: 線性模態) ---")
  let topo = @axiom.Topology::discrete(["a", "b", "c"])
  println("離散拓撲開集數: " + topo.opens.length().to_string())
  println("∞-Topos 截斷: " + @axiom.InfTopos::from_site(@axiom.Site::make([@axiom.ObjTag("U")])).is_infty.to_string())
  let omega_v = @axiom.omega_and(@axiom.True, @axiom.False)
  let omega_str = match omega_v { @axiom.True => "True"; @axiom.False => "False" }
  println("Ω 真值: " + omega_str)
  let lin = @axiom.Linear::make(100)
  let f = @axiom.Lolli::make(fn(x : Int) -> Int { x + 1 })
  println("線性消耗 f(100): " + f.apply(lin).consume().to_string())
  println("線性 HoTT 模態: " + @axiom.linear_hott_consume(@axiom.LinearHoTT::{ linear: @axiom.Linear::make(5), level: @axiom.SetLevel }).to_string())
  println("")
  println("--- 同倫 & 導出幾何 (HoTT: 合成同倫) ---")
  let s = @axiom.SSet::standard_simplex(2)
  println("Δ² 單形數: 0維=" + s.num_simplices(0).to_string() + " 1維=" + s.num_simplices(1).to_string() + " 2維=" + s.num_simplices(2).to_string())
  println("HoTT 球 S2: " + @axiom.hott_sphere(2).0)
  let cot = @axiom.cotangent_of_poly(3)
  println("餘切複形 Euler: " + cot.euler().to_string() + " 障礙: " + @axiom.deformation_obstruction(cot))
  println("HoTT 合成 cotangent: " + @axiom.hott_cotangent(@axiom.TypeTag("k[x,y]")).euler().to_string())
  println("")
  println("--- 群胚 & 2-群 (HoTT: 1-類型/2-類型) ---")
  let g = @axiom.Groupoid::pair_groupoid(["x", "y", "z"])
  println("對群胚分支數: " + g.connected_components().length().to_string())
  println("HoTT 路徑群胚: " + @axiom.path_groupoid(0).objects.length().to_string())
  let cm = @axiom.CrossedModule::trivial(4, 8)
  println("交叉模 π₀=" + cm.pi0().to_string() + " π₁=" + cm.pi1().to_string() + " Peiffer=" + cm.check_peiffer().to_string())
  println("HoTT 2-群 B(G,H): " + @axiom.crossed_to_hott(cm).0)
  println("")
  println("--- HoTT 核心 ---")
  println(@axiom.hott_demo())
  println(@axiom.hits_demo())
  println(@axiom.new_theorems_demo())
  println(@axiom.hott_algorithms_demo())
  println(@axiom.redefine_demo())
  println("")
  println("--- 單值性：公理 → 定理（零公理，窮盡驗證）---")
  println(@axiom.univalence_theorem_demo())
  println("摘要（每行一個基數；holds=true 即定理成立）:")
  println(@axiom.univalence_summary(4))
  println("")
  println("--- 有限立方體演算法（K1 立方體範疇 / K2 Kan 填充 / K3 cubical NBE）---")
  println(@axiom.cubical_demo())
  println("--- 整合管線 ---")
  println(@axiom.demo_pipeline())
  println(@axiom.high_dim_demo())
  println("")
  println("--- 算法複雜度對比（含 HoTT 新算法）---")
  println("A1 自由項共享: O(n²)→O(n α(n))  A2 濾餘極限: O(N)→O(log N)")
  println("H1 Cubical傳輸: O(n²)→O(n)  H3 截斷剪枝: O(2ⁿ)→O(n)")
  println("A4 稀疏融合: O(n³)→O(nnz·k)  A5 層查詢: O(2ⁿ)→O(n log n)")
  println("H4 合成π₁: O(n³)單純逼近→O(1)整數加法  H5 HIT記憶化: 路徑等價命中")
  println("A9 群胚商化: O(|G|n)→O(|π₀|n)  A10 2-群: O(|G||H|n)→O(|π₀||π₁|n)")
  println("")
  println("=== 零成本保證：所有泛型（含 Path/Equiv/HIT）在編譯時單態化，無虛表 ===")
}
